{
  "id": "time-notebook",
  "name": "时间笔记",
  "short_name": "时间笔记",
  "description": "带实时时钟和计时记录的手机笔记本：每条笔记自动打时间戳，可一键计时、手写草图、搜索与统计。",
  "lang": "zh-CN",
  "dir": "ltr",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#FBFBF7",
  "theme_color": "#16233A",
  "prefer_related_applications": false,
  "categories": ["productivity", "utilities"],
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "screenshots": [
    { "src": "screenshot-timeline.png", "sizes": "780x1688", "type": "image/png", "form_factor": "narrow", "label": "时间轴笔记与计时" },
    { "src": "screenshot-stats.png", "sizes": "780x1688", "type": "image/png", "form_factor": "narrow", "label": "专注时长统计" }
  ],
  "shortcuts": [
    { "name": "开始计时", "short_name": "计时", "url": "./index.html?action=track", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] },
    { "name": "快速记录", "short_name": "记录", "url": "./index.html?action=note", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] }
  ]
}
