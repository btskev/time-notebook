{
  "id": "time-notebook",
  "name": "时间笔记",
  "short_name": "时间笔记",
  "description": "个人时间轴、图片日记、习惯打卡与每日支出的本地优先 PWA。",
  "lang": "zh-CN",
  "dir": "ltr",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#FBFBF7",
  "theme_color": "#16233A",
  "prefer_related_applications": false,
  "categories": ["productivity", "utilities"],
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "screenshots": [
    { "src": "screenshot-timeline.png", "sizes": "780x1688", "type": "image/png", "form_factor": "narrow", "label": "时间轴笔记与计时" },
    { "src": "screenshot-stats.png", "sizes": "780x1688", "type": "image/png", "form_factor": "narrow", "label": "每日账单与月度汇总" }
  ],
  "shortcuts": [
    { "name": "开始计时", "short_name": "计时", "url": "./index.html?action=track", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] },
    { "name": "快速记录", "short_name": "记录", "url": "./index.html?action=note", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] },
    { "name": "记一笔支出", "short_name": "记一笔", "url": "./index.html?action=expense", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] },
    { "name": "写日记", "short_name": "日记", "url": "./index.html?action=diary", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] }
  ]
}
